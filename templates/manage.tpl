									<form method="post" action="{url router=PKP\core\PKPApplication::ROUTE_PAGE page="journalPayment" op="manage"}">{csrf}<input type="hidden" name="paymentId" value="{$record->payment_id|escape}"><button class="jp-icon-button jp-icon-verify" name="newStatus" value="verified" type="submit" data-tooltip="Verifikasi pembayaran" title="Verifikasi pembayaran" aria-label="Verifikasi pembayaran"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></button></form>
