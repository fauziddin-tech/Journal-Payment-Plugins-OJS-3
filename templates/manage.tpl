{if !$journalPaymentResultsOnly}
{if !$journalPaymentEmbedded}{include file="frontend/components/header.tpl" pageTitleTranslated=$pageTitleTranslated}{/if}
<style>:root {ldelim} --jp-accent: {$jpAccentColor|escape}; {rdelim}</style>
<main class="jp-page jp-admin{if $journalPaymentEmbedded} jp-embedded{/if}{if $isProductionEditorOnly} jp-production-editor-only{/if}" data-theme-mode="{$jpThemeMode|escape}">
	<div class="jp-admin-head"><div><h1>{if $isProductionEditorOnly}Production Editor{elseif $isFullPaymentManager}Manajemen Pembayaran{else}Pembayaran Ditugaskan{/if}</h1><span class="jp-version-badge" title="Versi plugin Journal Payment yang terpasang">Journal Payment v{$journalPaymentVersion|escape}</span></div><div class="jp-admin-head-actions" role="toolbar" aria-label="Tautan halaman pembayaran"><a class="jp-icon-button jp-icon-secondary jp-top-icon" target="_blank" rel="noopener" href="{url router=PKP\core\PKPApplication::ROUTE_PAGE page="journalPayment" op="documents"}" data-tooltip="Cari LOA dan sertifikat" title="Cari LOA dan sertifikat" aria-label="Cari LOA dan sertifikat"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 2h10l4 4v7"></path><path d="M14 2v5h5"></path><path d="M5 2v20h8"></path><circle cx="17" cy="17" r="3"></circle><path d="m19.2 19.2 2.3 2.3"></path></svg></a><a class="jp-icon-button jp-icon-secondary jp-top-icon" {if $journalPaymentEmbedded}target="_blank" rel="noopener"{/if} href="{url router=PKP\core\PKPApplication::ROUTE_PAGE page="journalPayment" op="submit"}" data-tooltip="Lihat halaman publik" title="Lihat halaman publik" aria-label="Lihat halaman pembayaran publik"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18"></path><path d="m16 8 3 3-3 3"></path></svg></a></div></div>
	{if $recordResult == 'updated'}<div class="jp-alert jp-alert-success" role="status"><strong>Data berhasil diperbarui.</strong></div>{elseif $recordResult == 'deleted'}<div class="jp-alert jp-alert-success" role="status"><strong>Data pembayaran dan bukti terkait berhasil dihapus.</strong></div>{elseif $recordResult == 'invalid'}<div class="jp-alert jp-alert-error" role="alert"><strong>Data belum dapat disimpan.</strong> Nama, email, WhatsApp, judul, tanggal terbit, serta data volume/nomor/tahun harus valid.</div>{elseif $recordResult == 'notFound'}<div class="jp-alert jp-alert-error" role="alert"><strong>Data pembayaran tidak ditemukan.</strong></div>{elseif $recordResult == 'financeLocked'}<div class="jp-alert jp-alert-error" role="alert"><strong>Transaksi sudah masuk laporan keuangan.</strong> Status dan data pembayaran tidak dapat dihapus agar riwayat setoran tetap utuh.</div>{/if}
	{if $documentMail == 'loaSent'}<div class="jp-alert jp-alert-success" role="status"><strong>Email LOA berhasil dikirim.</strong> Tautan dokumen telah dikirim melalui email penulis.</div>{elseif $documentMail == 'certificateSent'}<div class="jp-alert jp-alert-success" role="status"><strong>Email sertifikat berhasil dikirim.</strong> Tautan dokumen telah dikirim melalui email penulis.</div>{elseif $documentMail == 'invalidEmail'}<div class="jp-alert jp-alert-error" role="alert"><strong>Email tidak valid.</strong> Periksa alamat email penulis pada data submission.</div>{elseif $documentMail == 'unavailable'}<div class="jp-alert jp-alert-error" role="alert"><strong>Dokumen belum dapat dikirim.</strong> Pastikan pembayaran terverifikasi dan dokumen sudah diterbitkan.</div>{elseif $documentMail == 'sendFailed'}<div class="jp-alert jp-alert-error" role="alert"><strong>Email gagal dikirim.</strong> Periksa konfigurasi SMTP dan log email OJS.</div>{/if}
	{if $proofResult == 'uploaded'}<div class="jp-alert jp-alert-success" role="status"><strong>Galley akhir berhasil diunggah.</strong> Tautan proofreading telah dikirim kepada penulis melalui email.</div>{elseif $proofResult == 'uploadedEmailFailed'}<div class="jp-alert jp-alert-warning" role="status"><strong>Galley berhasil diunggah, tetapi email gagal dikirim.</strong> Kirim ulang email atau bagikan tautan melalui WhatsApp.</div>{elseif $proofResult == 'emailSent'}<div class="jp-alert jp-alert-success" role="status"><strong>Tautan proofreading berhasil dikirim ulang.</strong></div>{elseif $proofResult == 'emailFailed'}<div class="jp-alert jp-alert-error" role="alert"><strong>Email proofreading gagal dikirim.</strong> Periksa konfigurasi email OJS.</div>{elseif $proofResult == 'invalidFile'}<div class="jp-alert jp-alert-error" role="alert"><strong>Galley tidak valid.</strong> Unggah satu file PDF sesuai batas ukuran plugin.</div>{elseif $proofResult == 'published'}<div class="jp-alert jp-alert-warning" role="alert"><strong>Artikel sudah dipublikasikan.</strong> Galley proofreading baru tidak dapat ditambahkan setelah publikasi.</div>{elseif $proofResult == 'unavailable'}<div class="jp-alert jp-alert-error" role="alert"><strong>Proofreading belum tersedia.</strong> Pembayaran harus terverifikasi dan submission harus berada dalam penugasan Anda.</div>{elseif $proofResult == 'failed' or $proofResult == 'invalid'}<div class="jp-alert jp-alert-error" role="alert"><strong>Galley belum dapat diproses.</strong> Silakan periksa data dan coba kembali.</div>{/if}
	{if !$isProductionEditorOnly}<div class="jp-package-stats">{foreach from=$packageStats item=packageStat}<section class="jp-package-stat"><span>{$packageStat.name|escape}</span><strong>Rp {$packageStat.verified_total|number_format:0:',':'.'}</strong><small>{$packageStat.submission_count} transaksi · {$packageStat.verified_count} pembayaran diterima</small></section>{/foreach}</div>{/if}
	{if $view == 'production'}<style>.jp-filter{ldelim}display:none!important{rdelim}</style>{/if}
	<nav class="jp-manage-tabs" aria-label="Kelompok data pembayaran"><a class="{if $view == 'active'}is-active{/if}" href="{if $journalPaymentEmbedded}{$journalPaymentSettingsUrl|escape}?view=active#journalPayment{else}{url router=PKP\core\PKPApplication::ROUTE_PAGE page="journalPayment" op="manage" view="active"}{/if}" data-payment-view="active">Aktif <span>{$activeCount}</span></a><a class="{if $view == 'archive'}is-active{/if}" href="{if $journalPaymentEmbedded}{$journalPaymentSettingsUrl|escape}?view=archive#journalPayment{else}{url router=PKP\core\PKPApplication::ROUTE_PAGE page="journalPayment" op="manage" view="archive"}{/if}" data-payment-view="archive">Arsip <span>{$archiveCount}</span></a>{if $canManagePaymentRecords}<a class="jp-finance-tab {if $view == 'finance'}is-active{/if}" href="{if $journalPaymentEmbedded}{$journalPaymentSettingsUrl|escape}?view=finance#journalPayment{else}{url router=PKP\core\PKPApplication::ROUTE_PAGE page="journalPayment" op="manage" view="finance"}{/if}" data-payment-view="finance"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18v14H3z"></path><path d="M7 6V4h10v2M7 13h4M16 11v4M14 13h4"></path></svg>Keuangan</a>{/if}{if $isFullPaymentManager or $isProductionEditor}<a class="{if $view == 'production'}is-active{/if}" href="{if $journalPaymentEmbedded}{$journalPaymentSettingsUrl|escape}?view=production#journalPayment{else}{url router=PKP\core\PKPApplication::ROUTE_PAGE page="journalPayment" op="manage" view="production"}{/if}" data-payment-view="production">Production Editor</a>{/if}{if $isFullPaymentManager}<a class="jp-drive-tab {if $view == 'drive'}is-active{/if}" href="{if $journalPaymentEmbedded}{$journalPaymentSettingsUrl|escape}?view=drive#journalPayment{else}{url router=PKP\core\PKPApplication::ROUTE_PAGE page="journalPayment" op="manage" view="drive"}{/if}" data-payment-view="drive"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h7l2 2h9v11H3z"></path></svg>Folder GD</a><a class="jp-audit-tab {if $view == 'audit'}is-active{/if}" href="{if $journalPaymentEmbedded}{$journalPaymentSettingsUrl|escape}?view=audit#journalPayment{else}{url router=PKP\core\PKPApplication::ROUTE_PAGE page="journalPayment" op="manage" view="audit"}{/if}" data-payment-view="audit">Audit</a>{/if}</nav>
	<form class="jp-filter" {if $view == 'drive' or $view == 'finance' or $view == 'audit'}hidden{/if} method="get" action="{if $journalPaymentEmbedded}{$journalPaymentSettingsUrl|escape}{else}{url router=PKP\core\PKPApplication::ROUTE_PAGE page="journalPayment" op="manage"}{/if}"{if $journalPaymentEmbedded} data-fetch-url="{$journalPaymentFetchUrl|escape}"{/if}><input type="hidden" name="view" value="{$view|escape}"><input type="hidden" name="driveFolder" value="{$driveSelectedFolder|escape}"><input name="q" value="{$q|escape}" placeholder="Cari kode, ID artikel, nama, atau email"><select name="filter"><option value="">Semua Status Artikel</option>{foreach from=$editorialStatusOptions key=statusKey item=statusOption}<option value="{$statusKey|escape}" data-payment-scope="{$statusOption.scope|escape}" {if $statusOption.scope != $view}disabled hidden{/if} {if $filter == $statusKey}selected{/if}>{$statusOption.label|escape}</option>{/foreach}</select><select name="urgency"><option value="">Semua Prioritas</option>{foreach from=$urgencyOptions key=urgencyKey item=urgencyLabel}<option value="{$urgencyKey|escape}" {if $urgency == $urgencyKey}selected{/if}>{$urgencyLabel|escape}</option>{/foreach}</select><button class="jp-button" type="submit">Cari</button></form>
{/if}

	<div id="jp-payment-results" class="jp-payment-results" aria-live="polite">
	{if $view == 'finance'}
		<section class="jp-finance" aria-label="Laporan keuangan per nomor terbitan">
			{if $financeResult == 'submitted'}<div class="jp-alert jp-alert-success"><strong>Setoran berhasil dikirim.</strong> Bukti menunggu verifikasi administrator.</div>{elseif $financeResult == 'verified'}<div class="jp-alert jp-alert-success"><strong>Setoran telah diverifikasi.</strong></div>{elseif $financeResult == 'rejected'}<div class="jp-alert jp-alert-success"><strong>Setoran dikembalikan untuk diperbaiki.</strong></div>{elseif $financeResult == 'invalidFile'}<div class="jp-alert jp-alert-error"><strong>Bukti setoran tidak valid.</strong> Gunakan PDF, JPG, PNG, atau WebP sesuai batas unggahan.</div>{elseif $financeResult == 'invalid' or $financeResult == 'invalidDecision'}<div class="jp-alert jp-alert-error"><strong>Data setoran tidak valid.</strong> Periksa nominal, bukti, dan catatan keputusan.</div>{elseif $financeResult == 'failed'}<div class="jp-alert jp-alert-error"><strong>Bukti setoran belum dapat disimpan.</strong></div>{/if}
			<div class="jp-finance-summary"><div><span>Artikel Published</span><strong>{$financeTotals.articles|escape}</strong></div><div><span>Pendapatan Bruto</span><strong>Rp {$financeTotals.gross|number_format:0:',':'.'}</strong></div><div><span>Fee Editor</span><strong>Rp {$financeTotals.editor_share|number_format:0:',':'.'}</strong></div><div><span>Hak Administrator</span><strong>Rp {$financeTotals.admin_share|number_format:0:',':'.'}</strong></div><div><span>Setoran Diverifikasi</span><strong>Rp {$financeTotals.verified|number_format:0:',':'.'}</strong></div><div><span>Sisa Setoran</span><strong>Rp {$financeTotals.outstanding|number_format:0:',':'.'}</strong></div></div>
			<p class="jp-finance-note">Laporan hanya menghitung pembayaran terverifikasi dari artikel yang sudah berstatus <strong>Published</strong> di OJS. Pembagian tiap artikel dikunci saat pertama kali masuk laporan agar riwayat tidak berubah.</p>
			{if $isFullPaymentManager && $financeUnassignedCount > 0}<div class="jp-alert jp-alert-error"><strong>{$financeUnassignedCount} artikel Published belum memiliki editor keuangan.</strong> Tetapkan Section Editor pada workflow OJS, lalu muat ulang tab Keuangan.</div>{/if}
			{if $financeGroups|@count}<div class="jp-finance-groups">{foreach from=$financeGroups item=group}<article class="jp-finance-group"><header><div><span>Nomor Terbitan</span><h2>{$group.issue_label|escape}</h2><small>{$group.editor_name|escape} · {$group.articles} artikel</small></div><span class="jp-finance-balance {if $group.outstanding > 0}is-due{else}is-paid{/if}">{if $group.outstanding > 0}Sisa Rp {$group.outstanding|number_format:0:',':'.'}{else}Lunas{/if}</span></header><div class="jp-finance-metrics"><div><span>Bruto</span><strong>Rp {$group.gross|number_format:0:',':'.'}</strong></div><div><span>Fee editor</span><strong>Rp {$group.editor_share|number_format:0:',':'.'}</strong></div><div><span>Hak admin</span><strong>Rp {$group.admin_share|number_format:0:',':'.'}</strong></div><div><span>Menunggu verifikasi</span><strong>Rp {$group.pending|number_format:0:',':'.'}</strong></div></div><details class="jp-finance-articles"><summary>Rincian artikel</summary><table><thead><tr><th>ID</th><th>Judul</th><th>Pembayaran</th><th>Hak Admin</th></tr></thead><tbody>{foreach from=$group.article_rows item=article}<tr><td>{$article.article_id|escape}</td><td>{$article.title|escape}</td><td>Rp {$article.amount|number_format:0:',':'.'}</td><td>Rp {$article.admin_share|number_format:0:',':'.'}</td></tr>{/foreach}</tbody></table></details>{if $group.can_upload && $group.available_to_remit > 0}<details class="jp-remittance-upload"><summary>Unggah setoran administrator</summary><form method="post" enctype="multipart/form-data" action="{url router=PKP\core\PKPApplication::ROUTE_PAGE page="journalPayment" op="manage"}">{csrf}<input type="hidden" name="financeAction" value="uploadRemittance"><input type="hidden" name="issueKey" value="{$group.issue_key|escape}"><label><span>Nominal setoran (maksimal Rp {$group.available_to_remit|number_format:0:',':'.'})</span><input name="remittanceAmount" type="number" min="1" max="{$group.available_to_remit|escape}" value="{$group.available_to_remit|escape}" required></label><label><span>Bukti transfer</span><input name="remittanceProof" type="file" accept=".pdf,.jpg,.jpeg,.png,.webp" required></label><label class="jp-remittance-wide"><span>Catatan (opsional)</span><input name="remittanceNotes" maxlength="5000" placeholder="Contoh: setoran tahap 1"></label><button class="jp-button" type="submit">Kirim Setoran</button></form></details>{/if}</article>{/foreach}</div>{else}<div class="jp-card jp-empty">Belum ada pembayaran terverifikasi dari artikel Published yang dapat dimasukkan ke laporan keuangan.</div>{/if}
			<h2 class="jp-finance-history-title">Riwayat Setoran</h2>{if $financeRemittances|@count}<div class="jp-list-wrap"><table class="jp-remittance-table"><thead><tr><th>Tanggal</th><th>Terbitan / Editor</th><th>Nominal</th><th>Bukti</th><th>Status</th>{if $isFullPaymentManager}<th>Keputusan</th>{/if}</tr></thead><tbody>{foreach from=$financeRemittances item=remittance}<tr><td>{$remittance.created_at|jp_date:"d-m-Y H:i"}</td><td><strong>{$remittance.issue_label|escape}</strong><small>{$remittance.editor_name|escape}</small></td><td><strong>Rp {$remittance.amount|number_format:0:',':'.'}</strong>{if $remittance.editor_notes}<small>{$remittance.editor_notes|escape}</small>{/if}</td><td><a class="jp-icon-button jp-icon-secondary jp-document-preview" href="{url router=PKP\core\PKPApplication::ROUTE_PAGE page="journalPayment" op="remittanceProof" id=$remittance.remittance_id}" data-preview-name="Bukti Setoran — {$remittance.editor_name|escape}" data-tooltip="Lihat bukti setoran" title="Lihat bukti setoran" aria-label="Lihat bukti setoran"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"></path><circle cx="12" cy="12" r="3"></circle></svg></a></td><td><span class="jp-remittance-status jp-remittance-{$remittance.status|escape}">{if $remittance.status == 'verified'}Diverifikasi{elseif $remittance.status == 'rejected'}Perlu Perbaikan{else}Menunggu{/if}</span>{if $remittance.manager_notes}<small>{$remittance.manager_notes|escape}</small>{/if}</td>{if $isFullPaymentManager}<td>{if $remittance.status == 'pending'}<div class="jp-remittance-actions"><form method="post" action="{url router=PKP\core\PKPApplication::ROUTE_PAGE page="journalPayment" op="manage"}">{csrf}<input type="hidden" name="financeAction" value="verifyRemittance"><input type="hidden" name="remittanceId" value="{$remittance.remittance_id|escape}"><button class="jp-icon-button jp-icon-verify" type="submit" data-tooltip="Verifikasi setoran" title="Verifikasi setoran" aria-label="Verifikasi setoran"><svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"></path></svg></button></form><details><summary class="jp-icon-button jp-icon-secondary" data-tooltip="Minta perbaikan" title="Minta perbaikan"><svg viewBox="0 0 24 24"><path d="m4 4 16 16M20 4 4 20"></path></svg></summary><form method="post" action="{url router=PKP\core\PKPApplication::ROUTE_PAGE page="journalPayment" op="manage"}">{csrf}<input type="hidden" name="financeAction" value="rejectRemittance"><input type="hidden" name="remittanceId" value="{$remittance.remittance_id|escape}"><input name="remittanceManagerNotes" required maxlength="5000" placeholder="Alasan perbaikan"><button class="jp-button" type="submit">Kirim</button></form></details></div>{else}—{/if}</td>{/if}</tr>{/foreach}</tbody></table></div>{else}<div class="jp-card jp-empty">Belum ada riwayat setoran.</div>{/if}
			</section>
		{elseif $view == 'production'}
			{include file=$journalPaymentProductionEditorTemplate}
		{elseif $view == 'audit'}
		<section class="jp-audit" aria-label="Audit dan keamanan pembayaran">
			<div class="jp-audit-intro"><div><span>Audit &amp; Keamanan</span><strong>Riwayat aktivitas tidak dapat diedit dari antarmuka</strong><small>Menampilkan 150 aktivitas dan 150 email terbaru. Token dokumen tidak pernah ditampilkan di log.</small></div><div><span>Proteksi aktif</span><strong>Token 256-bit · QR permanen · pembatasan pencarian</strong><small>Identitas jaringan disimpan dalam bentuk hash, bukan alamat IP mentah.</small></div></div>
			<h2>Riwayat Perubahan</h2>
			{if $auditLogs|@count}<div class="jp-list-wrap"><table class="jp-audit-table"><thead><tr><th>Waktu / Pengguna</th><th>Aktivitas</th><th>Artikel</th><th>Nilai Lama</th><th>Nilai Baru</th></tr></thead><tbody>{foreach from=$auditLogs item=log}<tr><td><strong>{$log->created_at|jp_date:"d-m-Y H:i:s"}</strong><small>{$log->actor_name|escape}</small></td><td><strong>{$log->action_label|escape}</strong>{if $log->notes}<small>{$log->notes|escape}</small>{/if}</td><td>{if $log->article_id}{$log->article_id|escape}{else}—{/if}</td><td><small>{$log->old_display|escape|default:'—'}</small></td><td><small>{$log->new_display|escape|default:'—'}</small></td></tr>{/foreach}</tbody></table></div>{else}<div class="jp-card jp-empty">Belum ada aktivitas sejak fitur audit diaktifkan.</div>{/if}
			<h2>Riwayat Pengiriman Email</h2>
			{if $emailLogs|@count}<div class="jp-list-wrap"><table class="jp-audit-table"><thead><tr><th>Waktu</th><th>Jenis / Artikel</th><th>Penerima</th><th>Subjek</th><th>Status</th></tr></thead><tbody>{foreach from=$emailLogs item=mail}<tr><td>{$mail->created_at|jp_date:"d-m-Y H:i:s"}</td><td><strong>{$mail->email_type|replace:'_':' '|capitalize|escape}</strong><small>{if $mail->article_id}ID {$mail->article_id|escape}{else}—{/if}</small></td><td>{$mail->recipient|escape}</td><td>{$mail->subject|escape}</td><td><span class="jp-email-state jp-email-{$mail->status|escape}">{if $mail->status == 'sent'}Terkirim{else}Gagal{/if}</span>{if $mail->error_message}<small>{$mail->error_message|escape}</small>{/if}</td></tr>{/foreach}</tbody></table></div>{else}<div class="jp-card jp-empty">Belum ada riwayat email sejak fitur audit diaktifkan.</div>{/if}
		</section>
	{elseif $view == 'drive'}
		<section class="jp-drive-manager" data-drive-folder="{$driveSelectedFolder|escape}" aria-label="Pengelola file Google Drive">
			{if $driveResult == 'folderCreated'}<div class="jp-alert jp-alert-success" role="status"><strong>Folder berhasil dibuat di Google Drive.</strong></div>{elseif $driveResult == 'uploaded'}<div class="jp-alert jp-alert-success" role="status"><strong>File berhasil diunggah dan tersinkron ke Google Drive.</strong></div>{elseif $driveResult == 'renamed'}<div class="jp-alert jp-alert-success" role="status"><strong>Nama file berhasil diperbarui.</strong></div>{elseif $driveResult == 'trashed'}<div class="jp-alert jp-alert-success" role="status"><strong>File dipindahkan ke Sampah Google Drive.</strong> File masih dapat dipulihkan dari Drive.</div>{elseif $driveResult == 'notConfigured'}<div class="jp-alert jp-alert-error" role="alert"><strong>Google Drive belum dikonfigurasi.</strong></div>{elseif $driveResult == 'invalidFolder' or $driveResult == 'invalid'}<div class="jp-alert jp-alert-error" role="alert"><strong>Data folder atau file tidak valid.</strong></div>{elseif $driveResult == 'failed'}<div class="jp-alert jp-alert-error" role="alert"><strong>Operasi Google Drive gagal.</strong> Periksa koneksi dan log PHP.</div>{/if}
			{if $driveError == 'root'}<div class="jp-card jp-empty"><strong>Folder induk belum tersedia.</strong><br>Isi tautan folder Google Drive pada Pengaturan plugin.</div>
			{elseif $driveError == 'credentials'}<div class="jp-card jp-empty"><strong>OAuth Google Drive belum tersedia.</strong><br>Isi Client ID, Client Secret, dan Refresh Token pada Pengaturan plugin.</div>
			{elseif $driveError == 'connection'}<div class="jp-card jp-empty"><strong>Google Drive belum dapat dibaca.</strong><br>Periksa OAuth, izin folder, koneksi cURL, dan log PHP.</div>
			{else}
				<div class="jp-drive-summary">
					<div><span>Folder aktif</span><strong>{$driveSelectedFolderName|escape}</strong><small>{$driveFiles|@count} file publikasi</small></div>
					<div><span>Halaman terakhir</span><strong>{if $driveLastPage ne null}{$driveLastPage|escape}{else}Belum terdeteksi{/if}</strong><small>{if $driveLatestFile}{$driveLatestFile|escape}{else}Folder masih kosong{/if}</small></div>
					<div class="jp-drive-summary-actions" role="toolbar" aria-label="Tindakan Folder GD"><button class="jp-icon-button jp-icon-secondary" type="button" data-drive-refresh data-tooltip="Segarkan data Folder GD" title="Segarkan data Folder GD" aria-label="Segarkan data Folder GD"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6v5h-5"></path><path d="M4 18v-5h5"></path><path d="M6.1 9a7 7 0 0 1 11.4-2.4L20 9"></path><path d="M17.9 15a7 7 0 0 1-11.4 2.4L4 15"></path></svg></button><a class="jp-icon-button jp-icon-secondary" href="{$driveSelectedFolderUrl|escape}" target="_blank" rel="noopener" data-tooltip="Buka folder di Google Drive" title="Buka folder di Google Drive" aria-label="Buka folder di Google Drive"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h7l2 2h9v11H3z"></path><path d="m14 12 4-4m-3 0h3v3"></path></svg></a></div>
				</div>
				<div class="jp-drive-toolbar">
					<form method="post" action="{url router=PKP\core\PKPApplication::ROUTE_PAGE page="journalPayment" op="manage"}">{csrf}<input type="hidden" name="driveAction" value="createFolder"><input type="hidden" name="driveFolder" value="{$driveSelectedFolder|escape}"><input name="folderName" required maxlength="150" placeholder="Contoh: Volume 7 Nomor 3"><button class="jp-button" type="submit">Buat Folder</button></form>
					<form method="post" enctype="multipart/form-data" action="{url router=PKP\core\PKPApplication::ROUTE_PAGE page="journalPayment" op="manage"}">{csrf}<input type="hidden" name="driveAction" value="upload"><input type="hidden" name="driveFolder" value="{$driveSelectedFolder|escape}"><input type="file" name="driveFile" required accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.zip,.epub,.jpg,.jpeg,.png,.webp,.txt"><button class="jp-button" type="submit">Unggah File</button></form>
				</div>
				<div class="jp-drive-browser">
