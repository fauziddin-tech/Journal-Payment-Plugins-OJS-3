8 6V4h8v2M19 6l-1 15H6L5 6M10 11v5M14 11v5"></path></svg></button></form></div></article>{/foreach}</div>{else}<div class="jp-card jp-empty">Folder ini belum berisi file.</div>{/if}</div>
				</div>
			{/if}
