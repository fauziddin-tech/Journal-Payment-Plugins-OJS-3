msgstr "No record was found. Make sure the tracking code and email match the submitted data."
msgid "plugins.generic.journalPayment.success.title"
msgstr "Payment Submitted"
msgid "plugins.generic.journalPayment.success.text"
msgstr "Your payment proof was received and is awaiting journal manager verification."
