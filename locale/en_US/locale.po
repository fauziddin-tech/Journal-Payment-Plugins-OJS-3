msgstr "Enter bank name, account number, account holder, or QRIS instructions."
msgid "plugins.generic.journalPayment.settings.paymentMethods"
msgstr "Payment methods"
msgid "plugins.generic.journalPayment.settings.paymentMethods.description"
msgstr "One method per line."
msgid "plugins.generic.journalPayment.settings.packages"
msgstr "Payment types and fees"
msgid "plugins.generic.journalPayment.settings.packages.description"
msgstr "One item per line in Name|Amount format, for example APC|750000."
msgid "plugins.generic.journalPayment.settings.maxUploadMb"
msgstr "Upload limit (MB)"
