msgstr "Submit for Verification"
msgid "plugins.generic.journalPayment.instructions"
msgstr "Payment Instructions"
msgid "plugins.generic.journalPayment.security.title"
msgstr "Privacy and security"
msgid "plugins.generic.journalPayment.security.text"
msgstr "Payment proof is stored in OJS's private file directory and is accessible only to journal managers."
msgid "plugins.generic.journalPayment.error.heading"
msgstr "Please check the following:"
msgid "plugins.generic.journalPayment.error.csrf"
msgstr "The form session is invalid. Reload the page and try again."
msgid "plugins.generic.journalPayment.error.articleId"
msgstr "Article ID is required."
msgid "plugins.generic.journalPayment.error.name"
msgstr "Full name is required."
msgid "plugins.generic.journalPayment.error.email"
msgstr "The email address is invalid."
msgid "plugins.generic.journalPayment.error.package"
msgstr "The payment type is invalid."
msgid "plugins.generic.journalPayment.error.proof"
msgstr "Payment proof is required."
msgid "plugins.generic.journalPayment.error.fileSize"
msgstr "Payment proof must be between 1 byte and %s MB."
msgid "plugins.generic.journalPayment.error.fileType"
msgstr "File type is not allowed. Use PDF, JPG, PNG, or WebP."
msgid "plugins.generic.journalPayment.error.upload"
msgstr "The payment proof could not be saved. Check the OJS files directory permissions."
