msgid "plugins.generic.journalPayment.form.title"
msgstr "Article Title"
msgid "plugins.generic.journalPayment.form.package"
msgstr "Payment Type"
msgid "plugins.generic.journalPayment.form.choose"
msgstr "Choose a payment type"
msgid "plugins.generic.journalPayment.form.method"
msgstr "Payment Method"
msgid "plugins.generic.journalPayment.form.proof"
msgstr "Payment Proof"
msgid "plugins.generic.journalPayment.form.proofHelp"
msgstr "PDF, JPG, PNG, or WebP; up to {$max} MB."
msgid "plugins.generic.journalPayment.form.notes"
msgstr "Notes"
